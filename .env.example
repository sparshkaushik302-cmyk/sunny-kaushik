# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WordPress / WooCommerce REST API URL (e.g., https://your-domain.com/wp-json/wc/v3)
# When not set, the application automatically uses local demo product data.
VITE_WORDPRESS_API_URL=

# WhatsApp contact phone number for the floating chat button (e.g., 919876543210)
VITE_WHATSAPP_NUMBER=919876543210

# Site canonical URL for SEO and sharing
VITE_SITE_URL=https://kanhabazaar.com

# Optional custom AI endpoint (defaults to /api/chat handled by the Express server)
VITE_AI_API_ENDPOINT=/api/chat

# Optional server-side WooCommerce credentials (never exposed to browser)
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

